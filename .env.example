# ==============================================================================
# VARIABLES DE ENTORNO PARA INTELLI-TEC LMS
# Copia este archivo como .env y completa los valores correspondientes
# cp .env.example .env
# ==============================================================================

# Entorno de Flask ('desarrollo' o 'produccion')
FLASK_CONFIG=desarrollo
FLASK_APP=run.py
SECRET_KEY=cambia_esta_clave_por_una_cadena_larga_y_segura_en_produccion

# Puerto y SSL (opcional: poner en 'true' para requerir HTTPS con certificado adhoc)
PORT=5000
FLASK_USE_SSL=false

# ------------------------------------------------------------------------------
# BASE DE DATOS (MySQL / TiDB / SQLite)
# ------------------------------------------------------------------------------
# Para MySQL local (XAMPP / Laragon / Docker):
DATABASE_URL=mysql+pymysql://root:@localhost/intelli_tec_db

# Para TiDB Cloud (ejemplo con SSL requerido):
# DATABASE_URL=mysql+pymysql://<user>:<password>@<gateway-host>:4000/<database>?ssl_verify_cert=true&ssl_verify_identity=true

# Para SQLite local rápido (desarrollo sin MySQL instalado):
# DATABASE_URL=sqlite:///intelli_tec.db

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI (Generación de ejercicios, teoría y tutor MathBot)
# Obtén tu API key gratuita en: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=tu_google_gemini_api_key_aqui

# ------------------------------------------------------------------------------
# CLOUDINARY (Almacenamiento de portadas de cursos y lecciones)
# Obtén tus credenciales gratuitas en: https://cloudinary.com/
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
# O alternativamente el URL completo:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ------------------------------------------------------------------------------
# MICROSOFT ENTRA ID / AZURE AD (SSO Institucional ITST / TecNM)
# Opcional en desarrollo local: puedes ingresar con email/contraseña local
# ------------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/auth/callback

# ------------------------------------------------------------------------------
# USUARIO ADMINISTRADOR INICIAL (Para scripts/crear_usuario_admin.py)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@mathai.com
ADMIN_PASSWORD=admin123

